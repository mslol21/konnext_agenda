# ========================================================
# KONNEXY AGENDA - VARIÁVEIS DE AMBIENTE (SaaS Multi-tenant)
# ========================================================

# --------------------------------------------------------
# 1. BANCO DE DADOS & ORM (PostgreSQL com extensão btree_gist)
# --------------------------------------------------------
DATABASE_URL="postgresql://postgres:suasenha@localhost:5432/konnexy_agenda?schema=public"
DIRECT_URL="postgresql://postgres:suasenha@localhost:5432/konnexy_agenda?schema=public"

# --------------------------------------------------------
# 2. AUTENTICAÇÃO & SEGURANÇA
# --------------------------------------------------------
AUTH_SECRET="gere_um_segredo_forte_com_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="konnexy.com.br"

# --------------------------------------------------------
# 3. WHATSAPP CLOUD API (Meta Graph API Oficial)
# --------------------------------------------------------
# Defina MOCK_INTEGRATIONS=true para rodar localmente sem precisar de credenciais reais
MOCK_INTEGRATIONS=true
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_AUTO_REPLY_ENABLED=false

# --------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (Anthropic Claude API)
# --------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# --------------------------------------------------------
# 5. PAGAMENTOS DO SAAS & COBRANÇA DE SINAL
# --------------------------------------------------------
# Stripe (Assinaturas SaaS dos Salões)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER="price_starter_id"
STRIPE_PRICE_PRO="price_pro_id"
STRIPE_PRICE_BUSINESS="price_business_id"

# Asaas / Pix (Pagamento de Sinal pelo Cliente Final)
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT="sandbox"

# --------------------------------------------------------
# 6. E-MAIL TRANSACIONAL (Resend)
# --------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="nao-responda@konnexy.com.br"

# --------------------------------------------------------
# 7. GOOGLE CALENDAR OAUTH
# --------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google-calendar"

# URL pública e empresa do agendamento (obrigatório no domínio agenda.konnexy.com.br)
NEXT_PUBLIC_APP_URL="https://agenda.konnexy.com.br"
NEXT_PUBLIC_TENANT_SLUG="konnexy-demo"
GEMINI_API_KEY=""
