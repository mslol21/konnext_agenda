datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. TENANT & SUBSCRIPTION
// ----------------------------------------------------

enum SubscriptionPlan {
  starter
  pro
  business
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  unpaid
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  customDomain     String?  @unique @map("custom_domain")
  phone            String
  email            String
  address          String
  timezone         String   @default("America/Sao_Paulo")
  visualTheme      Json?    @map("visual_theme")
  businessSettings Json?    @map("business_settings")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships       UserMembership[]
  subscriptions     Subscription[]
  serviceCategories ServiceCategory[]
  services          Service[]
  professionals     Professional[]
  customers         Customer[]
  appointments      Appointment[]
  timeOffs          TimeOff[]
  payments          Payment[]
  reviews           Review[]
  notificationLogs  NotificationLog[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @map("tenant_id")
  plan                 SubscriptionPlan   @default(starter)
  status               SubscriptionStatus @default(trialing)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ----------------------------------------------------
// 2. USERS, MEMBERSHIPS & RBAC
// ----------------------------------------------------

enum Role {
  owner
  admin
  receptionist
  professional
  client
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  phone         String?
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships   UserMembership[]
  professionals Professional[]
  customers     Customer[]

  @@map("users")
}

model UserMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      Role     @default(client)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, role])
  @@index([tenantId])
  @@index([userId])
  @@map("user_memberships")
}

// ----------------------------------------------------
// 3. CATALOG: SERVICES & CATEGORIES
// ----------------------------------------------------

model ServiceCategory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("service_categories")
}

model Service {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  categoryId       String?  @map("category_id")
  name             String
  slug             String
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  durationMinutes  Int      @default(30) @map("duration_minutes")
  bufferMinutes    Int      @default(0) @map("buffer_minutes")
  imageUrl         String?  @map("image_url")
  color            String?  @default("#22d3ee")
  requiresDeposit  Boolean  @default(false) @map("requires_deposit")
  depositAmount    Decimal? @map("deposit_amount") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffAssigned ProfessionalService[]
  appointments Appointment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@map("services")
}

// ----------------------------------------------------
// 4. PROFESSIONALS, SCHEDULE & BLOCKS
// ----------------------------------------------------

enum ProfessionalStatus {
  active
  vacation
  inactive
}

model Professional {
  id                  String             @id @default(uuid())
  tenantId            String             @map("tenant_id")
  userId              String?            @map("user_id")
  name                String
  specialty           String
  description         String?
  photoUrl            String?            @map("photo_url")
  colorHex            String             @default("#22d3ee") @map("color_hex")
  commissionRate      Decimal            @default(40.0) @map("commission_rate") @db.Decimal(5, 2)
  experienceYears     Int                @default(1) @map("experience_years")
  instagram           String?
  googleCalendarToken Json?              @map("google_calendar_token")
  status              ProfessionalStatus @default(active)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  appointments Appointment[]

  @@index([tenantId])
  @@index([userId])
  @@map("professionals")
}

model ProfessionalService {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  professionalId  String   @map("professional_id")
  serviceId       String   @map("service_id")
  customPrice     Decimal? @map("custom_price") @db.Decimal(10, 2)
  customDuration  Int?     @map("custom_duration")
  createdAt       DateTime @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([tenantId])
  @@map("professional_services")
}

model WorkingHours {
  id             String  @id @default(uuid())
  professionalId String  @map("professional_id")
  dayOfWeek      Int     @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime      String  @map("start_time")  // HH:mm (e.g. "08:00")
  endTime        String  @map("end_time")    // HH:mm (e.g. "18:00")
  breakStart     String? @map("break_start") // HH:mm (e.g. "12:00")
  breakEnd       String? @map("break_end")   // HH:mm (e.g. "13:00")
  isWorking      Boolean @default(true) @map("is_working")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
  @@index([professionalId])
  @@map("working_hours")
}

model TimeOff {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  professionalId String?  @map("professional_id")
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([professionalId])
  @@map("time_offs")
}

// ----------------------------------------------------
// 5. CUSTOMERS & CRM
// ----------------------------------------------------

enum CustomerTier {
  padrao
  vip_ouro
  vip_diamante
}

model Customer {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  userId          String?      @map("user_id")
  name            String
  phone           String
  email           String
  tier            CustomerTier @default(padrao)
  colorFormula    String?      @map("color_formula")
  allergies       String?
  preferredBrands String?      @map("preferred_brands")
  notes           String?
  totalSpent      Decimal      @default(0.0) @map("total_spent") @db.Decimal(10, 2)
  visitsCount     Int          @default(0) @map("visits_count")
  lastVisit       DateTime?    @map("last_visit")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  reviews      Review[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

// ----------------------------------------------------
// 6. APPOINTMENTS, HOLDS & CONCURRENCY
// ----------------------------------------------------

enum AppointmentStatus {
  held
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum PaymentStatus {
  pending
  deposit_paid
  fully_paid
  refunded
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  customerId      String            @map("customer_id")
  professionalId  String            @map("professional_id")
  serviceId       String            @map("service_id")
  startAt         DateTime          @map("start_at")
  endAt           DateTime          @map("end_at")
  status          AppointmentStatus @default(confirmed)
  paymentStatus   PaymentStatus     @default(pending) @map("payment_status")
  price           Decimal           @db.Decimal(10, 2)
  discount        Decimal           @default(0.0) @db.Decimal(10, 2)
  finalPrice      Decimal           @map("final_price") @db.Decimal(10, 2)
  notes           String?
  googleEventId   String?           @map("google_event_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  holds        AppointmentHold?
  payments     Payment[]
  reviews      Review[]

  @@index([tenantId])
  @@index([professionalId, startAt, endAt])
  @@index([customerId])
  @@map("appointments")
}

model AppointmentHold {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  sessionToken  String   @map("session_token")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([expiresAt])
  @@map("appointment_holds")
}

// ----------------------------------------------------
// 7. PAYMENTS & REVIEWS
// ----------------------------------------------------

enum PaymentMethod {
  pix
  credit_card
  debit_card
  cash
}

enum TransactionStatus {
  pending
  paid
  refunded
  failed
}

model Payment {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  appointmentId String            @map("appointment_id")
  amount        Decimal           @db.Decimal(10, 2)
  method        PaymentMethod     @default(pix)
  status        TransactionStatus @default(pending)
  externalId    String?           @map("external_id")
  paidAt        DateTime?         @map("paid_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
  @@map("payments")
}

model Review {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  appointmentId String   @unique @map("appointment_id")
  customerId    String   @map("customer_id")
  rating        Int      @default(5)
  comment       String?
  isFeatured    Boolean  @default(false) @map("is_featured")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("reviews")
}

// ----------------------------------------------------
// 8. LOGS & AUDIT
// ----------------------------------------------------

enum NotificationChannel {
  whatsapp
  email
}

enum NotificationStatus {
  sent
  delivered
  read
  failed
}

model NotificationLog {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  recipient   String
  channel     NotificationChannel @default(whatsapp)
  template    String
  status      NotificationStatus  @default(sent)
  payload     Json?
  error       String?
  idempotency String              @unique
  sentAt      DateTime            @default(now()) @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([idempotency])
  @@map("notification_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  resource  String
  payload   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("audit_logs")
}
